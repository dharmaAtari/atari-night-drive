<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runtime settings for Atari Night Drive.
  Edit these without rebuilding; systems read values from here rather than
  hardcoding them.
-->
<config>

  <!-- Display: logical resolution the game renders at. -->
  <display>
    <width>640</width>
    <height>480</height>
    <!-- fit | envelop | resize | none -->
    <scaleMode>fit</scaleMode>
    <autoCenter>true</autoCenter>
    <fullscreen>false</fullscreen>
    <backgroundColor>#1a3aa8</backgroundColor>
    <pixelArt>true</pixelArt>
  </display>

  <!-- Performance -->
  <performance>
    <targetFps>60</targetFps>
  </performance>

  <!-- Audio: logical sound name -> file under bin/assets/sounds/ -->
  <audio>
    <master volume="1.0" />
    <sound name="enginesound" file="vroom.mp3" />
  </audio>

</config>
